# Urja-Sync Environment Configuration
# Copy this file to .env and modify as needed

# Server
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=urja-sync-dev-secret-change-in-production
JWT_EXPIRES_IN=24h

# Database (SQLite - no external DB needed)
DB_PATH=./data/urja-sync.db

# Redis (optional - falls back to in-memory cache)
REDIS_URL=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Simulation
SIMULATION_SEED=42
SIMULATION_DEFAULT_SPEED=1

# AI/Prediction Service (optional Python service)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_ENABLED=false

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
